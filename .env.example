# Somente no servidor. Nunca coloque credenciais em app.js ou data.js.
# Autenticação sem chave JSON (Vercel OIDC / Google Workload Identity Federation).
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=impulso-vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=whastapp
# Alternativa apenas para projetos que já permitem chaves de serviço:
# GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Prospects
# Senha de acesso ao aplicativo: no mínimo 16 caracteres.
APP_PASSWORD=
# Chave aleatória de no mínimo 32 caracteres para assinar sessões.
SESSION_SECRET=
